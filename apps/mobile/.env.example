# Copy this file to apps/mobile/.env and replace the placeholders with your own values.
# Expo inlines EXPO_PUBLIC_* variables when it bundles the app, so restart with
# `npx expo start --clear` after changing them. They ship inside the app: never put secrets here.

# Top Flow API origin. It must be reachable from the phone or emulator, not just your computer:
# use your computer's LAN IP on a device, http://10.0.2.2:3000 on the Android emulator, or a tunnel.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# Top Flow web app origin (no trailing slash needed). It serves product photos and the
# /auth/confirm page that sign-up confirmation and password recovery emails open.
EXPO_PUBLIC_WEB_URL=https://your-web-app.example.com

# Supabase project URL and publishable key (Supabase dashboard > Project Settings > API Keys).
# For the local Supabase CLI stack, use http://<your LAN IP>:54321 and the key from `supabase status`.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
