{
  "name": "web",
  "version": "3.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "eslint",
    "check-types": "next typegen && tsc --noEmit",
    "test": "jest",
    "test:demo": "node scripts/demo-smoke.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@topflow/shared": "*",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "jest": "^30.0.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.14",
    "typescript": "^7"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/lib"
    ],
    "testRegex": "\\.spec\\.tsx?$",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    }
  }
}
