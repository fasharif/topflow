# Web app (apps/web). Copy to apps/web/.env.local for local development.

# Supabase runs only on this server (ADR-013), so these values never reach browser JavaScript.
# `npx supabase status` prints both. Container images read them at runtime (see ADR-023).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The NestJS API, reached server-to-server by Server Components and the /api handler.
API_INTERNAL_URL=http://localhost:3000
# Same value as INTERNAL_API_SECRET in apps/api/.env (32+ random characters): lets the API trust
# the shopper's IP address that this server forwards.
INTERNAL_API_SECRET=

# Public origin of this app: links in emails, metadata, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Show the seeded demo accounts on the sign-in page (read when the app is built).
# NEXT_PUBLIC_DEMO_MODE=true

# Optional: report server-side errors to Sentry. Without SENTRY_DSN nothing is sent.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=staging              # defaults to NODE_ENV
# SENTRY_TRACES_SAMPLE_RATE=0             # share of requests traced for performance (0 to 1)
