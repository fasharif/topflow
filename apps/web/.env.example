# Copy this file to apps/web/.env.local. `npx supabase status` prints the local Supabase URL and keys.

# Supabase project URL and publishable key (sb_publishable_…). The publishable key is not a secret.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where this app's server reaches the API: the /api/* route handler and server-rendered catalogue pages.
API_INTERNAL_URL=http://localhost:3000
# Same value as INTERNAL_API_SECRET in apps/api/.env: lets this server forward shoppers' IP addresses.
INTERNAL_API_SECRET=

# Public origin used in email redirects, metadata and the sitemap (production only; no trailing slash).
# NEXT_PUBLIC_SITE_URL=https://topflow-hub.example.com

# Public portfolio demo (docs/OPERATIONS.md, "Public demo"). true shows the demo banner and the demo
# accounts, keeps the site out of search engines, and switches off sign-up, password reset emails and
# password or two-factor changes. Inlined at build time: rebuild after changing it. Only true or false.
NEXT_PUBLIC_DEMO_MODE=false
