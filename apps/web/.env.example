# Web app (apps/web). Copy this file to apps/web/.env.local (`npm run setup` does it for a local
# checkout). `npx supabase status` prints the local Supabase URL and keys.

# Supabase project URL and publishable key (sb_publishable_…). The publishable key is not a secret.
# Supabase runs only on this server (ADR-013), so these values never reach browser JavaScript.
# Container images read them at runtime (ADR-023).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where this app's server reaches the API: the /api/* route handler and server-rendered catalogue pages.
API_INTERNAL_URL=http://localhost:3000
# Same value as INTERNAL_API_SECRET in apps/api/.env (32+ random characters): lets this server forward
# shoppers' IP addresses.
INTERNAL_API_SECRET=

# Public origin of this app (no trailing slash): links in emails and page metadata. Behind a reverse
# proxy (the container images) the server only knows its own address, so set it in every deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Public portfolio demo (docs/OPERATIONS.md, "Public demo"; ADR-021). true shows the demo banner in place
# of the portfolio notice, names the site "TopFlow Hub portfolio demo" in page titles and link previews,
# lists the demo accounts on the sign-in page, and switches off sign-up, password reset emails and
# password or two-factor changes. Every build, demo or not, says that it is a portfolio project and asks
# search engines not to index it (ADR-023). Inlined at build time: rebuild after changing it. The
# container image takes it as a build argument instead (--build-arg NEXT_PUBLIC_DEMO_MODE=true, false
# unless set; apps/web/Dockerfile). Only true or false.
NEXT_PUBLIC_DEMO_MODE=false

# Optional: report server-side errors to Sentry. Without SENTRY_DSN nothing is sent.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=staging              # defaults to NODE_ENV
# SENTRY_TRACES_SAMPLE_RATE=0             # share of requests traced for performance (0 to 1)
