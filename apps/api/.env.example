# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development                      # development | test | production
PORT=3000
APP_VERSION=2.0.0
APP_PUBLIC_URL=http://localhost:3002      # Web app origin, used for links in emails

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
# `npm run db:up` starts a local Prisma Postgres; `docker compose up postgres` also works.
DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"
# Use 1 with the `prisma dev` server (PGlite serves one connection reliably); 10+ with PostgreSQL.
DATABASE_POOL_MAX=10

# ─── Authentication ─────────────────────────────────────────────────────────
# REQUIRED in production: random string, 32+ characters (e.g. `openssl rand -base64 48`).
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_SECURE=true                      # defaults to true in production
COOKIE_SAMESITE=lax                       # lax | strict | none
BCRYPT_ROUNDS=12

# ─── HTTP ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3002,http://localhost:8081
TRUST_PROXY=false                         # true behind Railway / a load balancer
# SWAGGER_ENABLED=true                    # defaults to false in production
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
AUTH_THROTTLE_LIMIT=10

# ─── Email ──────────────────────────────────────────────────────────────────
MAIL_TRANSPORT=console                    # console | resend
MAIL_FROM="Top Flow <no-reply@topflow.ae>"
RESEND_API_KEY=

# ─── Company details printed on quotations ──────────────────────────────────
COMPANY_LEGAL_NAME="Top Flow Irrigation & Flow Control Supplies"
COMPANY_TRN=
COMPANY_ADDRESS="Dubai, United Arab Emirates"
COMPANY_PHONE="+971 4 000 0000"
COMPANY_EMAIL=sales@topflow.ae
COMPANY_WEBSITE=www.topflow.ae
COMPANY_BANK_DETAILS=
