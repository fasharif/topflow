# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development                      # development | test | production
PORT=3000
APP_VERSION=3.0.0
APP_PUBLIC_URL=http://localhost:3002      # Web app origin, used for links in emails

# ─── Database (Supabase PostgreSQL) ─────────────────────────────────────────
# Local: `npm run supabase:start` starts the Supabase stack; its database listens on port 54322.
# Production (Vercel Functions): Supabase's transaction pooler (port 6543), for example
#   postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# Migrations need a session connection (port 5432). Set it where it differs from DATABASE_URL.
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"
DATABASE_POOL_MAX=10

# ─── Supabase Auth ──────────────────────────────────────────────────────────
SUPABASE_URL=http://127.0.0.1:54321
# Server-only secret key (sb_secret_…): staff invitations and account suspension. Never expose it.
SUPABASE_SECRET_KEY=
# Only for projects that still sign access tokens with the legacy JWT secret.
SUPABASE_JWT_SECRET=
# Require two-factor authentication (aal2) for back-office permissions.
STAFF_MFA_REQUIRED=false

# ─── HTTP ───────────────────────────────────────────────────────────────────
# Same value as in apps/web: lets the web app's server forward shoppers' IP addresses.
# REQUIRED in production: 32+ random characters (e.g. `openssl rand -base64 48`).
INTERNAL_API_SECRET=
CORS_ORIGINS=http://localhost:3002,http://localhost:8081
TRUST_PROXY=false                         # true behind Vercel or another proxy
# SWAGGER_ENABLED=true                    # defaults to false in production
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
AUTH_THROTTLE_LIMIT=10

# ─── Email (quotations, orders, team invitations) ───────────────────────────
MAIL_TRANSPORT=console                    # console | resend
MAIL_FROM="Top Flow <no-reply@topflow.ae>"
RESEND_API_KEY=

# ─── Company details printed on quotations ──────────────────────────────────
COMPANY_LEGAL_NAME="Top Flow Irrigation & Flow Control Supplies"
COMPANY_TRN=
COMPANY_ADDRESS="United Arab Emirates"
COMPANY_PHONE="+971 56 109 1235"
COMPANY_EMAIL=info@topflow.ae
COMPANY_WEBSITE=www.topflow.ae
COMPANY_BANK_DETAILS=
