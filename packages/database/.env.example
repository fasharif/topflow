# Copy this file to packages/database/.env (`npm run setup` does it for you). Prisma, the seed and
# `npm run demo:reset` read it. Variables already set in the shell take precedence.

# Local: `npm run supabase:start` starts the Supabase stack; its database listens on port 54322.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# Migrations need a session connection (port 5432). Set it where DATABASE_URL uses the transaction pooler.
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# With both set, the seed also creates the sign-in identities of the seeded accounts.
SUPABASE_URL=http://127.0.0.1:54321
# Server-only secret key (sb_secret_…) printed by `npx supabase status`. Never commit it.
SUPABASE_SECRET_KEY=
