# Top Flow uses one environment file per application:
#
#   apps/api/.env        → copy from apps/api/.env.example   (database, JWT, CORS, mail, company details)
#   apps/web/.env.local  → copy from apps/web/.env.example   (API_INTERNAL_URL, demo mode)
#   apps/mobile/.env     → EXPO_PUBLIC_API_URL=http://<your-LAN-IP>:3000
#
# Database commands (npm run db:deploy / db:seed / db:migrate) read DATABASE_URL from the
# environment or from packages/database/.env.
#
# docker compose only needs a JWT secret in the shell or in this directory's .env:
JWT_SECRET=
