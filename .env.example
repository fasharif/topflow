# Top Flow uses one environment file per application:
#
#   apps/api/.env        → copy from apps/api/.env.example   (database, JWT, CORS, mail, company details)
#   apps/web/.env.local  → copy from apps/web/.env.example   (API_INTERNAL_URL, demo mode)
#   apps/mobile/.env     → EXPO_PUBLIC_API_URL=http://<your-LAN-IP>:3000
#                          EXPO_PUBLIC_WEB_URL=https://web-tau-two-31.vercel.app   (web app origin that serves product photos)
#
# Database commands (npm run db:deploy / db:seed / db:migrate) read DATABASE_URL from the
# environment or from packages/database/.env. Seed options:
#   SEED_DEMO_PASSWORD=...        password for the demo accounts (the default is public: never use it in production)
#   SEED_RESET_PASSWORDS=true     also reset the password of demo accounts that already exist
#   SEED_DEMO_DOCUMENTS=false     skip the sample RFQs, quotations and orders
#   SEED_KEEP_UNLISTED=true       leave products that are not in the catalogue file published
#   SEED_FORCE=true               required to seed when NODE_ENV=production
#
# docker compose only needs a JWT secret in the shell or in this directory's .env:
JWT_SECRET=
