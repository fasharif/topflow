{
  "name": "@topflow/system-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Black-box tests against the running stack: Playwright journeys with axe accessibility checks, k6 load tests and Schemathesis API fuzzing",
  "license": "MIT",
  "scripts": {
    "e2e": "playwright test",
    "e2e:report": "playwright show-report reports/playwright",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "walkthrough:gif": "bash scripts/walkthrough-gif.sh",
    "load": "bash load/run-k6.sh",
    "load:check": "bash load/check-thresholds.sh",
    "contract": "bash contract/run-schemathesis.sh",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p load/tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@topflow/shared": "*",
    "@types/k6": "2.3.0",
    "@types/node": "26.6.4",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
